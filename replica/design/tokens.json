{
  "_note": "Original design system. Not measured from Alinea (no screenshots were available). 'accent' is a neutral placeholder: replica-brand replaces the VALUES, role names stay.",
  "fonts": {
    "display": {"family": "Manrope", "fallback": "system-ui, sans-serif", "license": "OFL (open)"},
    "body":    {"family": "Inter",   "fallback": "system-ui, sans-serif", "license": "OFL (open)", "features": "tnum, cv11"}
  },
  "type": {
    "xs":  {"size": 12, "line": 16, "weight": 500},
    "sm":  {"size": 14, "line": 20, "weight": 400},
    "md":  {"size": 16, "line": 24, "weight": 400},
    "lg":  {"size": 20, "line": 28, "weight": 600},
    "xl":  {"size": 28, "line": 34, "weight": 700},
    "2xl": {"size": 40, "line": 46, "weight": 700}
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": {"sm": 8, "md": 12, "lg": 20, "full": 9999},
  "shadow": {
    "card":  "0 1px 2px rgba(16,24,20,.06), 0 1px 1px rgba(16,24,20,.04)",
    "sheet": "0 -8px 32px rgba(16,24,20,.18)"
  },
  "motion": {"fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {"content_max": 480, "header_h": 56, "tabbar_h": 64, "gutter": 16, "breakpoints": {"sm": 480, "md": 768}},
  "colors": {
    "light": {
      "bg": "#F6F7F5", "surface": "#FFFFFF", "surface-2": "#ECEFEC",
      "border": "#D5DAD5", "border-input": "#6F7B73",
      "text": "#15201B", "text-muted": "#55625A",
      "accent": "#0B6B5D", "on-accent": "#FFFFFF", "accent-soft": "#DDEFEA", "on-accent-soft": "#0A4F45",
      "danger": "#B3261E", "danger-soft": "#FBE4E1", "success": "#146B3B", "success-soft": "#DDF1E5",
      "warning": "#7A4F00", "warning-soft": "#FBEFD2",
      "chart-1": "#0B6B5D", "chart-2": "#B25E09", "chart-3": "#3F5FC9", "chart-4": "#A33A78", "chart-5": "#5E6B1F", "chart-6": "#6B6F76"
    },
    "dark": {
      "bg": "#0D1311", "surface": "#151D1A", "surface-2": "#1E2824",
      "border": "#2C3833", "border-input": "#6D7C74",
      "text": "#E8EEEA", "text-muted": "#A3B0A8",
      "accent": "#4FD1B5", "on-accent": "#08130F", "accent-soft": "#14302A", "on-accent-soft": "#8DE8D3",
      "danger": "#FF8A80", "danger-soft": "#3A1D1B", "success": "#5BD68F", "success-soft": "#16301F",
      "warning": "#F2C14E", "warning-soft": "#332A12",
      "chart-1": "#4FD1B5", "chart-2": "#F0A04B", "chart-3": "#8CA2FF", "chart-4": "#E58AC2", "chart-5": "#B7CC5A", "chart-6": "#A3A9B3"
    }
  },
  "pairs": [
    ["text", "bg", 4.5, "body text on page"],
    ["text", "surface", 4.5, "body text on card"],
    ["text", "surface-2", 4.5, "body text on raised surface"],
    ["text-muted", "bg", 4.5, "secondary text on page"],
    ["text-muted", "surface", 4.5, "secondary text on card"],
    ["text-muted", "surface-2", 4.5, "secondary text on raised surface"],
    ["on-accent", "accent", 4.5, "primary button label"],
    ["on-accent-soft", "accent-soft", 4.5, "selected chip / choice card"],
    ["accent", "surface", 4.5, "accent text/link on card"],
    ["accent", "bg", 4.5, "accent text/link on page"],
    ["danger", "surface", 4.5, "error text on card"],
    ["danger", "danger-soft", 4.5, "error banner text"],
    ["success", "surface", 4.5, "gain text on card"],
    ["success", "success-soft", 4.5, "success banner text"],
    ["warning", "warning-soft", 4.5, "disclaimer banner text"],
    ["border-input", "surface", 3.0, "input border (non-text 3:1)"],
    ["border-input", "bg", 3.0, "input border on page (non-text 3:1)"],
    ["accent", "surface", 3.0, "focus ring (non-text 3:1)"],
    ["chart-1", "surface", 3.0, "chart series 1"],
    ["chart-2", "surface", 3.0, "chart series 2"],
    ["chart-3", "surface", 3.0, "chart series 3"],
    ["chart-4", "surface", 3.0, "chart series 4"],
    ["chart-5", "surface", 3.0, "chart series 5"],
    ["chart-6", "surface", 3.0, "chart series 6"]
  ]
}
