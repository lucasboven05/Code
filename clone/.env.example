# Copy to .env.local and fill in. Never commit real values.

# --- Turn the backend on (leave unset to keep the offline, browser-only mode) ---
NEXT_PUBLIC_BACKEND=supabase

# --- Supabase (create the project yourself: Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only if your project still uses the legacy shared JWT secret (Settings > API > JWT secret).
# Leave empty on projects with signing keys: tokens are then verified against the project's published keys.
SUPABASE_JWT_SECRET=

# --- Database (Supabase: Settings > Database > Connection string, "Transaction pooler" or direct) ---
DATABASE_URL=

# --- Allie (optional). Without a key, Allie uses scripted answers. ---
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. A cheaper choice is claude-haiku-5-5 (no server-side refusal fallback; scripted answers cover refusals).
ALLIE_MODEL=

# --- Scheduled job (Vercel Cron sends this as a Bearer token). Generate a long random string. ---
CRON_SECRET=
